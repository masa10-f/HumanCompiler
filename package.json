    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "clean": "pnpm -r clean"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  },
  "pnpm": {
    "overrides": {
      "postcss-selector-parser@>=6 <6.1.5": "^6.1.5",
      "glob@>=9 <14.0.2": "^14.0.2",
      "minimatch@>=7 <11.0.1": "^11.0.1"
    }
  }

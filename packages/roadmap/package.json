{
  "name": "humancompiler-roadmap",
  "version": "0.1.0",
  "description": "Draw a HumanCompiler project roadmap (PNG/SVG) and its schedule summary on your machine",
  "license": "AGPL-3.0-or-later",
  "author": "Masato Fukushima <masa1063fuk@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/masa10-f/HumanCompiler.git",
    "directory": "packages/roadmap"
  },
  "keywords": [
    "humancompiler",
    "roadmap",
    "gantt",
    "cli",
    "agent"
  ],
  "bin": {
    "humancompiler-roadmap": "dist/cli.js"
  },
  "files": [
    "dist",
    "fonts",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "type-check": "tsc --noEmit",
    "test": "node scripts/build.mjs && node --test test/cli.test.mjs",
    "prepublishOnly": "pnpm run type-check && pnpm run test"
  },
  "dependencies": {
    "@resvg/resvg-js": "2.6.2"
  },
  "devDependencies": {
    "@expo-google-fonts/noto-sans-jp": "0.4.4",
    "@types/node": "^20.14.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.3.0"
  }
}

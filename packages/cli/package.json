  "license": "AGPL-3.0-or-later",
  "author": "Masato Fukushima <masa1063fuk@gmail.com>",
  "homepage": "https://github.com/masa10-f/HumanCompiler/tree/main/packages/cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/masa10-f/HumanCompiler.git",
    "directory": "packages/cli"
  },
  "keywords": [
    "humancompiler",
